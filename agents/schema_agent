#All column names were standardized to lowercase snake_case
#e.g. tipo_imposta and Tipo Imposta
#Columns such as mese, anno, attivazioni etc. were converted to numeric formats

import pandas as pd
import re

class SchemaValidationAgent:
    """
    Agent responsible for detecting naming convention violations 
    and data type mismatches, without altering the underlying data.
    """
    def __init__(self, dataset_name: str, df: pd.DataFrame):
        self.dataset_name = dataset_name
        self.df = df
        self.report = {
            "dataset": self.dataset_name,
            "naming_issues": [],
            "type_issues": []
        }

    def check_naming_conventions(self):
        """
        Validates column names against standard naming conventions 
        (e.g., snake_case, no special characters, doesn't start with a number).
        """
        # Regex for standard snake_case: starts with a lowercase letter, 
        # followed by only lowercase letters, numbers, or underscores.
        valid_pattern = re.compile(r'^[a-z][a-z0-9_]*$')
        
        for col in self.df.columns:
            if not valid_pattern.match(str(col)):
                self.report["naming_issues"].append(col)
                
        return self.report["naming_issues"]

    def check_data_types(self, expected_numeric_cols: list):
        """
        Checks if columns that are expected to be numeric are currently
        being interpreted as text (objects) due to bad characters.
        """
        for col in expected_numeric_cols:
            if col in self.df.columns:
                # If the column is not already recognized as a native numeric type
                if not pd.api.types.is_numeric_dtype(self.df[col]):
                    self.report["type_issues"].append(col)
            else:
                # Optionally flag missing expected columns
                pass 
                
        return self.report["type_issues"]

    def run_validation(self, expected_numeric_cols: list):
        """Runs all checks and returns a summary report."""
        self.check_naming_conventions()
        self.check_data_types(expected_numeric_cols)
        return self.report
          